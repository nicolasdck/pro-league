# Copy this file to secrets.properties (gitignored) and fill in the real values.
# Both are the PUBLIC anon key / URL — the same ones already embedded in the
# deployed web app's JS bundle (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in
# the main repo's .env.local). Row Level Security only allows SELECT with
# this key (see supabase/schema.sql) — it can never write. Not a secret in
# the same sense as the service_role key, which never leaves Vercel.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
