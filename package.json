{
  "name": "pro-league",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-d1:local": "tsx --env-file=.env.local scripts/sync-d1-local.mjs",
    "sync-cup:local": "tsx --env-file=.env.local scripts/sync-cup-local.mjs",
    "sync-europe:local": "tsx --env-file=.env.local scripts/sync-europe-local.mjs",
    "sync-news:local": "tsx --env-file=.env.local scripts/sync-news-local.mjs",
    "sync-player-stats:local": "tsx --env-file=.env.local scripts/sync-player-stats-local.mjs",
    "logos:localize": "node --env-file=.env.local scripts/localize-logos.mjs",
    "icon:generate": "node scripts/generate-app-icon.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^5.8.27",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
