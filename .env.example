# Client-side (safe to expose — protected by Supabase RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Web Push public key — generate the pair with `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=

# Server-side only (Vercel project env vars — never prefix with VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
